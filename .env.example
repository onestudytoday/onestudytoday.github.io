# Copy this to .env and fill it in. NEVER commit .env - .gitignore blocks it.
# In GitHub Actions these live in Settings > Secrets and variables > Actions.

# ---------------------------------------------------------------- SECRETS
# From your Meta app dashboard. You already have all four of these.
META_APP_ID=
META_APP_SECRET=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Real Altmetric attention scores for ranking candidates by
# projected engagement (sources.engagement_proxy). Requires applying for a
# free key through Altmetric's Scientometric Researcher Access program -
# there's no instant signup, and it's not guaranteed for a non-academic
# project - see RUNBOOK 1.6. Leave blank and sourcing falls back to the free
# citations + open-access proxy automatically; nothing else changes.
ALTMETRIC_API_KEY=

# ---- Crossposting (both entirely optional; unset = skipped, never an error)
#
# BLUESKY: the one worth turning on. Free, no review, no app to create - just
# an app password from Settings > Privacy and Security > App Passwords on
# bsky.app. Use an APP PASSWORD (the xxxx-xxxx-xxxx-xxxx kind), never your
# real account password.
BLUESKY_APP_PASSWORD=

# THREADS: needs its own Meta app with the "Threads use case" - an Instagram
# token does NOT work here, and neither do your existing Meta app id/secret.
# That means a separate OAuth consent flow to get a token and a user id.
# See RUNBOOK 1.7. Leave blank until you have done that; Threads stays inert.
#
# NOTE: this token lasts 60 days. token-refresh.yml renews it every Sunday,
# but an ALREADY-EXPIRED Threads token cannot be refreshed at all - it needs
# the whole consent flow again - so do not let the weekly job stay red.
THREADS_ACCESS_TOKEN=

# Fine-grained GitHub PAT with "Secrets: read and write" on this repo only.
# This is what lets the Sunday job write the refreshed Instagram token back
# into your repository secrets. Without it, refresh works but you have to
# paste the new token in by hand every 60 days.
GH_PAT=

# --------------------------------------------------------------- SETTINGS
# Where GitHub Pages serves your slide images from. Instagram downloads the
# images from these URLs, so they must be public.
#   https://<your-github-username>.github.io/<repo-name>/img
PUBLIC_IMAGE_BASE=

# Your Instagram handle, used on slides and on the link-in-bio page.
HANDLE=@onestudytoday

# neon | block | editorial
THEME=neon

# true  = preprints can post, with a forced "NOT PEER REVIEWED" badge
# false = preprints are hard-rejected
ALLOW_PREPRINTS=true

# How far back to look for new studies.
RECENCY_DAYS=14

# Drafting model.
DRAFT_MODEL=claude-sonnet-4-5

# Graph API version. Bump when Meta deprecates one.
GRAPH_VERSION=v23.0

TZ=America/Chicago

# ---- Crossposting identity (public, so these are `vars` not `secrets` in CI)
# Your Bluesky handle, e.g. onestudytoday.bsky.social
BLUESKY_HANDLE=
# Your numeric Threads user id, from GET https://graph.threads.net/v1.0/me
THREADS_USER_ID=

# ---- Reels
# Which weekday niches publish as a Reel instead of a carousel, comma
# separated. Default: wildcard (Friday), because docs/LAUNCH.md ranks the
# Friday Reel as the #2 source of the first hundred followers and the only
# format that reaches non-followers in volume at a standing start.
#
# To turn Reels OFF set this to the literal "off". An EMPTY value means
# "unset", which means the default, which means Reels stay ON - GitHub Actions
# sets undefined vars to "", so empty has to keep meaning "use the default".
REEL_NICHES=
