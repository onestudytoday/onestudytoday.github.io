# NEVER commit credentials. GitHub Secrets holds them in CI.
.env
.env.*
!.env.example

# API response cache - regenerated on demand
data/cache/

# Local record of when the Instagram token last rotated. Holds the last eight
# characters of each token - not enough to use, but no reason to publish it.
data/token_history.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store

# Rendered PNGs are working files. The JPEGs in docs/img/ ARE committed,
# because Instagram needs to fetch them from a public URL.
out/posts/
out/styles/
